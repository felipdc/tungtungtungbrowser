--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-ios ]
    symbols: [ _dlopen, _dlsym, _printf, _fflush, _vsnprintf, _getpid, _read, _write, _close, _socket, _bind, _listen, _accept, _setsockopt, _alarm, _bzero, _memcpy ]
...
