--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-ios ]
    symbols: [ _dlopen, _dlsym, _socket, _bind, _listen, _accept, _getsockname,
               _setsockopt, _close, _open, _printf, _snprintf, _fflush, _getpid,
               _usleep, ___error, _sysctlbyname, _read, _write, _time,
               __NSConcreteStackBlock, _memcpy, _bzero, _connect, _poll ]
...
