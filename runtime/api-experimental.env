# Explicit experimental browser API profile. Pass with docker compose --env-file.
# Set TTT_VM_DIR and TTT_RUNTIME_DIR separately to absolute, external directories.
# This does not install firmware, native helpers or the optional QEMU FP patch.
TTT_VM_MEMORY_GIB=3
TTT_VM_CPUS=2
TTT_RENDER_THREADS=1
TTT_TCG_CACHE_MIB=1024
TTT_CONTAINER_CPUS=4
TTT_CONTAINER_MEMORY=10g
TTT_SHM_SIZE=6g
TTT_CLOCK_INTERVAL_SECONDS=60
# Compatibility mode permits otherwise refused Metal approximations and records them.
# Set this to empty in a separate run to assess rendering without census mode.
TTT_RENDER_DIAGNOSTICS_DIR=/vm/census
