# Opt-in warmed capture resource profile; see docs/resident-browser.md.
# Prepare and verify a 393x852@1 guest separately. This file does not change iOS
# display scale, install native helpers, clear website state or configure a proxy.
TTT_VM_MEMORY_GIB=3
TTT_VM_CPUS=3
TTT_RENDER_THREADS=1
TTT_TCG_CACHE_MIB=1024
TTT_CONTAINER_CPUS=4
TTT_CONTAINER_MEMORY=7g
TTT_CONTAINER_MEMORY_SWAP=11g
TTT_SHM_SIZE=6g
TTT_CLOCK_INTERVAL_SECONDS=60
TTT_RENDER_DIAGNOSTICS_DIR=/vm/census
