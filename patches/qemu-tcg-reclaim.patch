+/*
+ * Only after all TB metadata has been destroyed, while no translated code
+ * can execute. Private anonymous mappings are zero-filled on their next
+ * use. Keep every page containing the permanent prologue/pools, and leave
+ * guard pages and the virtual cache capacity unchanged.
+ */
+static void tcg_region_discard_code(void)
+{
+#ifdef CONFIG_LINUX
+    const size_t page_size = qemu_real_host_page_size();
+
+    if (!code_reclaim) {
+        return;
+    }
+    assert(tcg_splitwx_diff == 0);
+    for (size_t i = 0; i < region.n; i++) {
+        void *start, *end;
+        uintptr_t first, last;
+
+        tcg_region_bounds(i, &start, &end);
+        first = QEMU_ALIGN_UP((uintptr_t)start, page_size);
+        last = QEMU_ALIGN_DOWN((uintptr_t)end, page_size);
+        if (first < last &&
+            qemu_madvise((void *)first, last - first, QEMU_MADV_DONTNEED)) {
+            /* Failed advice retains valid stale bytes; never unmap them. */
+            warn_report_once("tb-reclaim: could not discard obsolete code: %s",
+                             strerror(errno));
+        }
+    }
+#endif
+}
