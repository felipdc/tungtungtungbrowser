     /** @cpu_exec_exit: Callback for cpu_exec cleanup */
     void (*cpu_exec_exit)(CPUState *cpu);
+    /**
+     * @tb_exec_enter: Prepare host state immediately before a translated chain.
+     * Translation and the surrounding emulator loop run outside this scope.
+     */
+    void (*tb_exec_enter)(CPUState *cpu);
+    /**
+     * @tb_exec_exit: Restore host state after a translated chain, including
+     * nonlocal exits. Must be harmless when no chain is currently entered.
+     */
+    void (*tb_exec_exit)(CPUState *cpu);
     /** @debug_excp_handler: Callback for handling debug exceptions */
     void (*debug_excp_handler)(CPUState *cpu);
 
