+/*
+ * Experimental scheduling backoff, not a modeled ARM event-register wait.
+ * A bounded sleep cannot lose an event and halt a vCPU indefinitely. Host
+ * scheduling can extend the requested delay; guest locks are never altered.
+ * Called only in parallel TCG, outside the big QEMU lock.
+ */
+void HELPER(wfe_backoff)(uint32_t microseconds)
+{
+    g_usleep(microseconds);
+}
