    struct llvmpipe_screen *screen = llvmpipe_screen(pscreen);
 
    if (mem->fd) {
+      /* Release the backing pages while this allocation still owns its range.
+       * Unmapping alone leaves them resident in the screen's shared memfd.
+       * Do this before returning the range to mem_heap, since another thread
+       * may immediately allocate and write it. Unsupported filesystems retain
+       * the previous behavior; reclamation is only a memory optimization.
+       * Imported/exported memory uses the separate free_memory_fd path.
+       */
+      int ret;
+      do {
+         ret = fallocate(mem->fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE,
+                         mem->offset, mem->size);
+      } while (ret == -1 && errno == EINTR);
+
       mtx_lock(&screen->mem_mutex);
       util_vma_heap_free(&screen->mem_heap, mem->offset, mem->size);
       mtx_unlock(&screen->mem_mutex);
